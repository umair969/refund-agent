{
  "name": "refund-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A support agent that can issue refunds safely: every action audit-logged, risky actions need human approval, behaviour checked by evals.",
  "scripts": {
    "start": "tsx src/cli.ts",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
